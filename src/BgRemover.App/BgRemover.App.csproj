<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BackgroundRemover</AssemblyName>
    <RootNamespace>BgRemover.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>false</EnableCompressionInSingleFile><SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\models\isnet-general-use.onnx')">
    <EmbeddedResource Include="..\..\models\isnet-general-use.onnx" LogicalName="isnet-general-use.onnx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgRemover.Core\BgRemover.Core.csproj" />
  </ItemGroup>

</Project>
