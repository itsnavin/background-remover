<Window x:Class="BgRemover.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Remover" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        AllowDrop="True" Drop="Window_Drop" Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry>
                        <GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup>
                    </GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDD"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDD"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#DDD"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="Open images…" Click="Open_Click"/>
            <Button Content="Save current…" Click="SaveCurrent_Click"/>
            <Button x:Name="ExportAllBtn" Content="Export all…" Click="ExportAll_Click"/>
            <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
            <Button Content="Clear list" Click="Clear_Click"/>
            <Separator Margin="6,0"/>
            <TextBlock Text="View:" VerticalAlignment="Center" Margin="6,0"/>
            <RadioButton x:Name="ViewResult" Content="Result" IsChecked="True" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
            <RadioButton x:Name="ViewSplit" Content="Before/After" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
            <RadioButton x:Name="ViewOriginal" Content="Original" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
            <RadioButton x:Name="ViewMask" Content="Mask" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
            <Slider x:Name="SplitSlider" Width="110" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" ValueChanged="Split_Changed" ToolTip="Before/After divider"/>
            <Button Content="Fit" Margin="10,0,6,0" Click="Fit_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="FileList" Grid.Column="0" Margin="8,0,4,0" Background="#262626" Foreground="#DDD"
                     SelectionChanged="FileList_SelectionChanged" BorderBrush="#3A3A3A">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#999"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="Viewer" Grid.Column="1" Margin="4,0" ClipToBounds="True" Background="{StaticResource Checker}"
                    MouseWheel="Viewer_MouseWheel" MouseDown="Viewer_MouseDown" MouseMove="Viewer_MouseMove"
                    MouseUp="Viewer_MouseUp" MouseLeave="Viewer_MouseLeave" SizeChanged="Viewer_SizeChanged">
                <Grid>
                    <Canvas x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1" Height="1">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom"/>
                                <TranslateTransform x:Name="Pan"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image x:Name="MainImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="OriginalImage" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                    </Canvas>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="BrushCursor" Visibility="Collapsed" Stroke="White" StrokeThickness="1.5"/>
                    </Canvas>
                    <TextBlock x:Name="Hint" Text="Drop images or folders here, or click Open images…"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontSize="16"/>
                    <Border x:Name="Busy" Visibility="Collapsed" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8">
                        <TextBlock x:Name="BusyText" Text="Working…" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" Margin="4,0,8,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Refine brush" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ToolPan" Content="Pan" IsChecked="True" Checked="Tool_Changed"/>
                        <RadioButton x:Name="ToolKeep" Content="Keep" Checked="Tool_Changed"/>
                        <RadioButton x:Name="ToolRemove" Content="Remove" Checked="Tool_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Brush size (screen px)" Margin="0,6,0,0"/>
                    <Slider x:Name="BrushSize" Minimum="4" Maximum="200" Value="40"/>
                    <TextBlock Text="Brush hardness" Margin="0,2,0,0"/>
                    <Slider x:Name="BrushHardness" Minimum="0" Maximum="1" Value="0.6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Undo (Ctrl+Z)" Click="Undo_Click"/>
                        <Button Content="Reset edits" Click="ResetEdits_Click"/>
                    </StackPanel>
                    <TextBlock Text="Pan: right/middle-drag, zoom: wheel" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Text="Edge" FontWeight="Bold" Margin="0,14,0,4"/>
                    <TextBlock Text="Feather (px)"/>
                    <Slider x:Name="FeatherSlider" Minimum="0" Maximum="20" Value="0" ValueChanged="Setting_Changed"/>
                    <TextBlock Text="Shrink / grow edge"/>
                    <Slider x:Name="ShiftSlider" Minimum="-0.5" Maximum="0.5" Value="0" ValueChanged="Setting_Changed"/>
                    <CheckBox x:Name="DecontCheck" Content="Remove old-background colour fringes" IsChecked="True" Click="Setting_Changed"/>

                    <TextBlock Text="Background" FontWeight="Bold" Margin="0,14,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BgTransparent" Content="Transparent" IsChecked="True" Checked="Setting_Changed"/>
                        <RadioButton x:Name="BgSolid" Content="Solid" Checked="Setting_Changed"/>
                        <RadioButton x:Name="BgImage" Content="Image" Checked="Setting_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Colour #" VerticalAlignment="Center"/>
                        <TextBox x:Name="BgHex" Width="80" Text="FFFFFF" Margin="6,0" TextChanged="Setting_Changed"/>
                        <Button Content="Pick image…" Click="PickBgImage_Click"/>
                    </StackPanel>

                    <TextBlock Text="Export" FontWeight="Bold" Margin="0,14,0,4"/>
                    <ComboBox x:Name="FormatBox" SelectedIndex="0">
                        <ComboBoxItem Content="PNG (alpha)"/>
                        <ComboBoxItem Content="WebP lossless (alpha)"/>
                        <ComboBoxItem Content="WebP lossy (alpha)"/>
                        <ComboBoxItem Content="JPEG (white if transparent)"/>
                    </ComboBox>

                    <TextBlock Text="Processing" FontWeight="Bold" Margin="0,14,0,4"/>
                    <CheckBox x:Name="GpuCheck" Content="Use GPU (DirectML) when available" IsChecked="True" Click="Gpu_Click"/>
                    <CheckBox x:Name="FlipCheck" Content="Higher quality (flip averaging, slower)" Click="Flip_Click"/>
                    <TextBlock x:Name="ProviderText" Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready. Everything is processed locally; nothing is uploaded." VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="Progress" Grid.Column="1" Height="14" Minimum="0" Maximum="1"/>
        </Grid>
    </Grid>
</Window>
